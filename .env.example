# ==============================================================================
# DATABASE (Neon Serverless PostgreSQL)
# ==============================================================================
# Connection string from your Neon Dashboard:
# Format: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# Tip: Use Neon database branches (e.g. 'dev', 'staging', 'main') for isolated environments
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ==============================================================================
# BETTER AUTH CONFIGURATION
# ==============================================================================
# Generate a secure 32+ character random string (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET=your_better_auth_secret_key_min_32_characters
BETTER_AUTH_URL=http://localhost:3000

# ==============================================================================
# DATABASE SEED CREDENTIALS
# ==============================================================================
SEED_ADMIN_NAME="Al Syed Admin"
SEED_ADMIN_EMAIL=admin@alsyedfabrications.com
SEED_ADMIN_PASSWORD=YourSecureAdminPassword123!

# ==============================================================================
# CLOUDINARY IMAGE STORAGE (Gallery & Uploads)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ==============================================================================
# RESEND EMAIL NOTIFICATIONS (Quote & Contact Alerts)
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here

# ==============================================================================
# APPLICATION URL
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
